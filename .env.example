# =============================================================
# Scrappy / Firecrawl — Docker Compose environment template
# Copy this file to .env and fill in your values before running
#   cp .env.example .env
# =============================================================

# ===== Required =====

# Port the API is exposed on the host (default: 3002)
PORT=3002

# Internal container port (must match the port the application binds to inside the container)
INTERNAL_PORT=3002

# Bind address — keep 0.0.0.0 so the container is reachable from the host
HOST=0.0.0.0

# Set to false to skip Supabase authentication (recommended for self-hosted)
USE_DB_AUTHENTICATION=false

# Admin UI key — change this to a strong random secret before exposing publicly
BULL_AUTH_KEY=CHANGEME

# ===== Auto-configured by docker-compose (no changes needed) =====
# REDIS_URL=redis://redis:6379
# REDIS_RATE_LIMIT_URL=redis://redis:6379
# PLAYWRIGHT_MICROSERVICE_URL=http://playwright-service:3000/scrape

# ===== PostgreSQL (change for production deployments) =====
# POSTGRES_USER=firecrawl
# POSTGRES_PASSWORD=change_me_in_production
# POSTGRES_DB=firecrawl

# ===== AI features (optional) =====
# Required only for /extract, JSON scrape format, and agent features
# OPENAI_API_KEY=sk-...

# Experimental: Ollama local LLM
# OLLAMA_BASE_URL=http://host.docker.internal:11434/api
# MODEL_NAME=deepseek-r1:7b
# MODEL_EMBEDDING_NAME=nomic-embed-text

# Experimental: Any OpenAI-compatible API
# OPENAI_BASE_URL=https://your-provider.com/v1

# ===== Proxy (optional) =====
# PROXY_SERVER=http://proxy-host:port
# PROXY_USERNAME=
# PROXY_PASSWORD=
# BLOCK_MEDIA=true

# ===== Search (optional) =====
# Use a SearXNG instance instead of direct Google search
# SEARXNG_ENDPOINT=http://your.searxng.server
# SEARXNG_ENGINES=
# SEARXNG_CATEGORIES=

# ===== Concurrency & performance (optional) =====
# NUM_WORKERS_PER_QUEUE=8
# CRAWL_CONCURRENT_REQUESTS=10
# MAX_CONCURRENT_JOBS=5
# BROWSER_POOL_SIZE=5

# ===== Notifications (optional) =====
# SLACK_WEBHOOK_URL=
# SELF_HOSTED_WEBHOOK_URL=
# SELF_HOSTED_WEBHOOK_HMAC_SECRET=

# ===== Logging (optional) =====
# NONE | ERROR | WARN | INFO | DEBUG | TRACE
# LOGGING_LEVEL=INFO

# ===== Resource thresholds (optional) =====
# MAX_CPU=0.8
# MAX_RAM=0.8
